# ---- Core ----
NODE_ENV=production
PORT=8080
APP_URL=http://localhost:8080
LOG_LEVEL=info

# ---- Database (PostgreSQL) ----
# DATABASE_URL is used by the application at runtime (non-superuser, subject to row-level security).
# DATABASE_ADMIN_URL is used for migrations (schema owner).
POSTGRES_DB=itsm
POSTGRES_USER=itsm
POSTGRES_PASSWORD=change-me-postgres
APP_DB_USER=itsm_app
APP_DB_PASSWORD=change-me-app-db
DATABASE_URL=postgres://itsm_app:change-me-app-db@postgres:5432/itsm
DATABASE_ADMIN_URL=postgres://itsm:change-me-postgres@postgres:5432/itsm

# ---- Redis (queues, caching, rate limiting) ----
REDIS_URL=redis://redis:6379

# ---- Security ----
# Generate with: openssl rand -hex 32
JWT_SECRET=change-me-to-a-64-char-random-hex
ENCRYPTION_KEY=change-me-to-a-64-char-random-hex
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=14
COOKIE_SECURE=false

# ---- Initial administrator (created on first start if no users exist) ----
ADMIN_EMAIL=admin@msp.local
ADMIN_PASSWORD=Admin@12345
ADMIN_NAME=Platform Administrator

# ---- Demo data (set to true to load a realistic sample dataset on first start) ----
SEED_DEMO_DATA=true

# ---- Attachments ----
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=/data/storage
MAX_UPLOAD_MB=50

# ---- Email (SMTP) ----
SMTP_HOST=mailhog
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="Progression Service Desk <servicedesk@msp.local>"

# ---- AI Assistant ----
# AI_PROVIDER: anthropic | openai_compatible | none. Restart the app after changing any of these.
AI_PROVIDER=none
# Anthropic (AI_PROVIDER=anthropic): key + a Claude model id
ANTHROPIC_API_KEY=
# Model id for the selected provider. Anthropic: claude-sonnet-5-5. OpenAI: gpt-4o-mini, gpt-4o, gpt-5-mini ...
# Ollama / vLLM / LM Studio: the model name the server exposes (e.g. llama3.1).
AI_MODEL=claude-sonnet-5-5
# OpenAI-compatible endpoints (AI_PROVIDER=openai_compatible). The app appends /chat/completions.
#   OpenAI:    OPENAI_COMPATIBLE_BASE_URL=https://api.openai.com/v1   OPENAI_COMPATIBLE_API_KEY=sk-...   AI_MODEL=gpt-4o-mini
#   Ollama:    OPENAI_COMPATIBLE_BASE_URL=http://ollama:11434/v1      (no key)                             AI_MODEL=llama3.1
#   Azure:     the deployment base URL ending in /openai/deployments/<name>, plus the api key
# Verify from the product: Administration -> Settings -> Assistant connection -> Test connection.
OPENAI_COMPATIBLE_BASE_URL=
OPENAI_COMPATIBLE_API_KEY=| openai_compatible | none
AI_PROVIDER=none
ANTHROPIC_API_KEY=
AI_MODEL=claude-sonnet-5-5
# For on-premise/OpenAI-compatible endpoints (e.g. vLLM, Ollama)
OPENAI_COMPATIBLE_BASE_URL=
OPENAI_COMPATIBLE_API_KEY=
